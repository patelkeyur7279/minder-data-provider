{
  "name": "minder-data-provider",
  "version": "2.2.0",
  "description": "React data layer with one API from your UI to any backend or provider — built on TanStack Query, with auth, caching, and platform storage adapters for web, native, and server",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "minder": "./bin/minder.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.mts",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "llms.txt",
    "scripts",
    "bin",
    "src/cli"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    },
    "./web": {
      "types": "./dist/platforms/web.d.ts",
      "import": "./dist/platforms/web.mjs",
      "require": "./dist/platforms/web.js"
    },
    "./nextjs": {
      "types": "./dist/platforms/nextjs.d.ts",
      "import": "./dist/platforms/nextjs.mjs",
      "require": "./dist/platforms/nextjs.js"
    },
    "./native": {
      "types": "./dist/platforms/native.d.ts",
      "import": "./dist/platforms/native.mjs",
      "require": "./dist/platforms/native.js"
    },
    "./expo": {
      "types": "./dist/platforms/expo.d.ts",
      "import": "./dist/platforms/expo.mjs",
      "require": "./dist/platforms/expo.js"
    },
    "./electron": {
      "types": "./dist/platforms/electron.d.ts",
      "import": "./dist/platforms/electron.mjs",
      "require": "./dist/platforms/electron.js"
    },
    "./node": {
      "types": "./dist/platforms/node.d.ts",
      "import": "./dist/platforms/node.mjs",
      "require": "./dist/platforms/node.js"
    },
    "./hook": {
      "types": "./dist/hook.d.ts",
      "import": "./dist/hook.mjs",
      "require": "./dist/hook.js"
    },
    "./crud": {
      "types": "./dist/crud/index.d.ts",
      "import": "./dist/crud/index.mjs",
      "require": "./dist/crud/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.mjs",
      "require": "./dist/auth/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.mjs",
      "require": "./dist/cache/index.js"
    },
    "./websocket": {
      "types": "./dist/websocket/index.d.ts",
      "import": "./dist/websocket/index.mjs",
      "require": "./dist/websocket/index.js"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.mjs",
      "require": "./dist/realtime/index.js"
    },
    "./upload": {
      "types": "./dist/upload/index.d.ts",
      "import": "./dist/upload/index.mjs",
      "require": "./dist/upload/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug/index.mjs",
      "require": "./dist/debug/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.mjs",
      "require": "./dist/config/index.js"
    },
    "./ssr": {
      "types": "./dist/ssr/index.d.ts",
      "import": "./dist/ssr/index.mjs",
      "require": "./dist/ssr/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.mjs",
      "require": "./dist/logger/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    },
    "./providers/supabase": {
      "types": "./dist/providers/supabase.d.ts",
      "import": "./dist/providers/supabase.mjs",
      "require": "./dist/providers/supabase.js"
    },
    "./providers/stripe": {
      "types": "./dist/providers/stripe.d.ts",
      "import": "./dist/providers/stripe.mjs",
      "require": "./dist/providers/stripe.js"
    },
    "./providers/clerk": {
      "types": "./dist/providers/clerk.d.ts",
      "import": "./dist/providers/clerk.mjs",
      "require": "./dist/providers/clerk.js"
    },
    "./providers/firebase": {
      "types": "./dist/providers/firebase.d.ts",
      "import": "./dist/providers/firebase.mjs",
      "require": "./dist/providers/firebase.js"
    },
    "./providers/razorpay": {
      "types": "./dist/providers/razorpay.d.ts",
      "import": "./dist/providers/razorpay.mjs",
      "require": "./dist/providers/razorpay.js"
    },
    "./providers/sentry": {
      "types": "./dist/providers/sentry.d.ts",
      "import": "./dist/providers/sentry.mjs",
      "require": "./dist/providers/sentry.js"
    },
    "./providers/authjs": {
      "types": "./dist/providers/authjs.d.ts",
      "import": "./dist/providers/authjs.mjs",
      "require": "./dist/providers/authjs.js"
    },
    "./providers/auth0": {
      "types": "./dist/providers/auth0.d.ts",
      "import": "./dist/providers/auth0.mjs",
      "require": "./dist/providers/auth0.js"
    },
    "./providers/cognito": {
      "types": "./dist/providers/cognito.d.ts",
      "import": "./dist/providers/cognito.mjs",
      "require": "./dist/providers/cognito.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/check-peer-deps.js || true",
    "prepublishOnly": "npm run clean && npm run build && npm run generate:bundle-sizes && npm run test && npm run verify-build && npm run verify:treeshake",
    "verify-build": "node scripts/verify-build.js",
    "verify-lazy-loading": "node scripts/verify-lazy-loading.js",
    "security-audit": "npm audit --audit-level moderate",
    "generate:env-example": "node scripts/generate-env-example.js",
    "generate:catalog": "node scripts/generate-catalog.js",
    "check-versions": "node scripts/check-peer-deps.js",
    "fix-versions": "node scripts/fix-peer-deps.js",
    "certify:provider": "node scripts/certify-provider.js",
    "release:check": "npm run clean && npm run build && npm run test && npm run verify-build && npm pack --dry-run && npm run verify:treeshake",
    "release:preflight": "node scripts/release-preflight.js",
    "release:verify": "node scripts/release-preflight.js --verify",
    "verify:treeshake": "node scripts/verify-consumer-treeshake.mjs",
    "verify:api": "node scripts/verify-api-surface.mjs",
    "snapshot:api": "node scripts/verify-api-surface.mjs --update",
    "measure:bundles": "node scripts/measure-bundles.mjs",
    "budgets:check": "node scripts/measure-bundles.mjs --check",
    "budgets:update": "node scripts/measure-bundles.mjs --write-budgets",
    "bench": "node benchmarks/run-benchmarks.mjs",
    "generate:bundle-sizes": "node scripts/measure-bundles.mjs --json > dist/bundle-sizes.json"
  },
  "keywords": [
    "react",
    "tanstack-query",
    "react-query",
    "nextjs",
    "data-provider",
    "data-fetching",
    "api-client",
    "hooks",
    "crud",
    "optimistic-updates",
    "typescript",
    "cors",
    "websocket",
    "caching",
    "state-management"
  ],
  "author": "Minder Data Provider Team",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "axios": "^1.18.1",
    "dompurify": "^3.4.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rspack/core": "^2.1.4",
    "@tanstack/query-core": "^5.90.6",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.24",
    "@types/react": "^18.2.73",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^2.6.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.62.2",
    "ts-jest": "^29.1.2",
    "tsnapi": "^1.0.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.3"
  },
  "peerDependencies": {
    "@auth0/auth0-spa-js": "^2.0.0",
    "@clerk/clerk-js": "^5.0.0",
    "@sentry/browser": "^8.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@tanstack/query-core": "^5.90.6",
    "@tanstack/react-query": "^5.90.6",
    "@tanstack/react-query-devtools": "^5.90.2",
    "aws-amplify": "^6.0.0",
    "firebase": "^10.0.0",
    "next-auth": "^5.0.0-beta.0",
    "razorpay": "^2.9.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "stripe": "^14.0.0"
  },
  "peerDependenciesMeta": {
    "@auth0/auth0-spa-js": {
      "optional": true
    },
    "@clerk/clerk-js": {
      "optional": true
    },
    "aws-amplify": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/react-query-devtools": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    },
    "razorpay": {
      "optional": true
    },
    "@sentry/browser": {
      "optional": true
    },
    "stripe": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/examples/"
    ],
    "preset": "ts-jest",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true,
            "module": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 57,
        "functions": 51,
        "lines": 63,
        "statements": 63
      }
    }
  },
  "homepage": "https://github.com/patelkeyur7279/minder-data-provider#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/patelkeyur7279/minder-data-provider.git"
  },
  "bugs": {
    "url": "https://github.com/patelkeyur7279/minder-data-provider/issues"
  },
  "discussions": {
    "url": "https://github.com/patelkeyur7279/minder-data-provider/discussions"
  },
  "Discord Community": "https://discord.gg/dN3eFFjmfy"
}
