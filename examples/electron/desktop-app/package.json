{
  "name": "@minder-examples/electron-desktop-app",
  "version": "1.0.0",
  "description": "Electron desktop app example using Minder Data Provider",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "package": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "build": "node --check src/main.js && node --check src/preload.js && node --check smoke/main.js && node --check smoke/preload.js && node -e \"require.resolve('minder-data-provider/electron')\"",
    "test": "node --test smoke/lib/*.test.js",
    "ci:smoke": "node smoke/run-ci-smoke.mjs"
  },
  "keywords": [
    "electron",
    "minder",
    "desktop",
    "data-provider"
  ],
  "author": "Minder Examples",
  "license": "MIT",
  "devDependencies": {
    "@tanstack/react-query": "^5.90.6",
    "electron": "^43.0.0",
    "electron-builder": "^24.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "minder-data-provider": "file:../../../"
  },
  "build": {
    "appId": "com.minder.desktop-app",
    "productName": "Minder Desktop App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
