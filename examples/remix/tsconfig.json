{
  // Standalone consumer config, same reasoning as ../edge-worker/tsconfig.json:
  // its PRESENCE stops any tool from walking up to the repo root tsconfig,
  // whose `paths: { "minder-data-provider": ["./src/index.ts"] }` (a type-test
  // mapping) would redirect the bare import to LIBRARY SOURCE instead of the
  // installed package (file: link locally, packed tarball in CI).
  "include": ["app/**/*", "test/**/*", "react-router.config.ts", "vite.config.ts", "vitest.config.ts", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  }
}
