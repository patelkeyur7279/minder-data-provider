{
  "openapi": "3.0.3",
  "info": {
    "title": "Petstore (test fixture)",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "https://api.example.com/v1" }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pet" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPet" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "A single pet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewPet" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/pets/{petId}/vaccinations/{vaccinationId}": {
      "get": {
        "operationId": "getPetVaccination",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "vaccinationId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "A single vaccination record",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Vaccination" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/owner": {
      "get": {
        "operationId": "getPetOwner",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "The pet's owner — a person or an organization",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/Person" },
                    { "$ref": "#/components/schemas/Organization" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service health — no operationId (exercises derived-name generation)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetStatus": {
        "type": "string",
        "enum": ["available", "pending", "sold"]
      },
      "Pet": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "tag": { "type": "string" },
          "status": { "$ref": "#/components/schemas/PetStatus" }
        }
      },
      "NewPet": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "tag": { "type": "string" }
        }
      },
      "Vaccination": {
        "type": "object",
        "required": ["id", "name", "date"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "date": { "type": "string" }
        }
      },
      "Person": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string", "enum": ["person"] },
          "name": { "type": "string" }
        }
      },
      "Organization": {
        "type": "object",
        "required": ["kind", "name"],
        "properties": {
          "kind": { "type": "string", "enum": ["org"] },
          "name": { "type": "string" }
        }
      }
    }
  }
}
