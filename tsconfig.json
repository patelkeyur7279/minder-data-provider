{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    "moduleResolution": "NodeNext",
    "esModuleInterop": true,

    "allowSyntheticDefaultImports": true,

    // Enum Preservation - Required for enums to be available at runtime
    "preserveConstEnums": true,

    // Task 3.2 (`minder generate` codegen): lets the committed golden fixture
    // below type-check its `import ... from 'minder-data-provider'` (the
    // real published package specifier — what actual generated output uses)
    // against this repo's own source, since there is no self-referencing
    // `node_modules/minder-data-provider` link in a plain checkout. Inert for
    // every other file: nothing under src/**/* imports the package's own
    // name, so this mapping only ever resolves for the golden file below.
    "paths": {
      "minder-data-provider": ["./src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    // QR-D1: compile-time type test for typed routes. `include` is otherwise
    // scoped to `src/**/*` only, so this one file is named explicitly to put
    // it under `npm run type-check` (its @ts-expect-error / inference
    // assertions are the gate that proves createTypedMinder's typing works).
    // Deliberately NOT `tests/**/*` — that would pull the whole suite (with
    // its intentional `any`/loose-typing) into this strict, src-only check.
    "tests/typed-routes-types.test.ts",
    // Task 3.2: golden output of `minder generate --from
    // tests/fixtures/openapi-petstore.json` — regenerated and byte-compared
    // by tests/openapi-codegen.test.ts. Committing it here (rather than only
    // type-checking a throwaway temp file inside the test) means a codegen
    // change that produces output TypeScript itself rejects fails
    // `npm run type-check` in CI, not just the jest suite.
    "tests/fixtures/generated-petstore.routes.ts"
  ]
}
